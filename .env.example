# Server-only. Do not prefix these with NEXT_PUBLIC_.
# Copy this file to .env.local and fill in values from the Supabase dashboard.
# Never commit .env.local.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Privileged CLI / server-side scheduled collector only. Never expose to browsers.
SUPABASE_SECRET_KEY=

# Vercel Production only: random 32-byte secret for the authenticated cron route.
# Optional for local CLI use. Never prefix NEXT_PUBLIC_.
CRON_SECRET=

# Public site origin used in digest email links (no trailing slash). Never NEXT_PUBLIC_.
SITE_URL=

# Resend transactional email for the digest. Never prefix NEXT_PUBLIC_.
# RESEND_FROM example after verifying a domain: CampusRadar <alerts@your-domain>
RESEND_API_KEY=
RESEND_FROM=
